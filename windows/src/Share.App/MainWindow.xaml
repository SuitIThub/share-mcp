<Window x:Class="Share.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Share.App"
        Title="Share" Width="440" Height="680" MinWidth="340" MinHeight="400"
        Icon="pack://application:,,,/Share;component/share.ico"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Language="de-DE">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Show" />
        <app:NotNullToVisibility x:Key="ShowIfSet" />
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Paste" Executed="OnPaste" />
    </Window.CommandBindings>
    <DockPanel Margin="16,8,16,16">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Einstellungen" Click="OnSettings" AutomationProperties.AutomationId="settings" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Share" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="status" />
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource Show}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Schließen" Command="{Binding CloseMessage}" Style="{StaticResource Small}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="message" AutomationProperties.LiveSetting="Assertive" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Button DockPanel.Dock="Top" Content="Mit Server koppeln" Margin="0,10,0,0" Click="OnPair" AutomationProperties.AutomationId="pairNow"
                Visibility="{Binding NeedsPairing, Converter={StaticResource Show}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Offene Anfragen" Style="{StaticResource Heading}" />
                <TextBlock Text="Keine offenen Anfragen" Visibility="{Binding NoIncoming, Converter={StaticResource Show}}" />
                <ItemsControl ItemsSource="{Binding Incoming}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                                    <Expander Header="Details" Margin="0,4">
                                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                                    </Expander>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="Ablehnen" Command="{Binding Decline}" Style="{StaticResource Small}" />
                                            <Button Content="Annehmen" Command="{Binding Accept}" Style="{StaticResource Small}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Remaining}" VerticalAlignment="Center" Opacity="0.7" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Laufend" Style="{StaticResource Heading}" />
                <TextBlock Text="Keine Übertragungen" Visibility="{Binding NoRunning, Converter={StaticResource Show}}" />
                <ItemsControl ItemsSource="{Binding Running}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Info" Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="6" Margin="0,6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}" Visibility="{Binding Progress, Converter={StaticResource ShowIfSet}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Content="{Binding OpenLabel}" Command="{Binding Open}" Style="{StaticResource Small}" Visibility="{Binding OpenLabel, Converter={StaticResource ShowIfSet}}" />
                                        <Button Content="Kopieren" Command="{Binding Copy}" Style="{StaticResource Small}" Visibility="{Binding CanCopy, Converter={StaticResource Show}}" />
                                        <Button Content="Abbrechen" Command="{Binding Cancel}" Style="{StaticResource Small}" Visibility="{Binding CanCancel, Converter={StaticResource Show}}" />
                                        <Button Content="Schließen" Command="{Binding Dismiss}" Style="{StaticResource Small}" Visibility="{Binding CanDismiss, Converter={StaticResource Show}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="Info" Property="Foreground" Value="#D13438" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Senden an" Style="{StaticResource Heading}" />
                <TextBlock Text="Noch kein anderes Gerät gekoppelt" Visibility="{Binding NoDevices, Converter={StaticResource Show}}" />
                <app:TargetPicker DataContext="{Binding Targets}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Dateien…" Click="OnFiles" IsEnabled="{Binding Targets.CanSend}" AutomationProperties.AutomationId="sendFiles" />
                    <Button Content="Text/Link" Click="OnText" Margin="8,0,0,0" AutomationProperties.AutomationId="sendText" />
                </StackPanel>
                <TextBlock Text="Oder Dateien hierher ziehen bzw. mit Strg+V einfügen." Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
