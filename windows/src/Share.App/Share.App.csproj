<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Share.App</RootNamespace>
    <AssemblyName>Share</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>share.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <Product>Share</Product>
    <!-- the manifest sets per-monitor DPI awareness for WPF; WinForms is only used for the tray icon -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Resource Include="share.ico" />
    <InternalsVisibleTo Include="Share.App.Tests" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <ProjectReference Include="../Share.Core/Share.Core.csproj" />
  </ItemGroup>
</Project>
