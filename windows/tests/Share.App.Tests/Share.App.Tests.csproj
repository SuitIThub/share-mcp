<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Share.App.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1031;xUnit1051;xUnit2012;xUnit2013;xUnit2017</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <ProjectReference Include="../../src/Share.App/Share.App.csproj" />
    <Compile Include="../Share.Core.Tests/GoServer.cs" />
    <Compile Include="../Share.Core.Tests/TestFiles.cs" />
    <Compile Include="../Share.Core.Tests/ScriptedServer.cs" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="Xunit" />
    <Using Include="Share.Core" />
    <Using Include="Share.Core.Tests" />
    <Content Include="../Share.Core.Tests/xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
