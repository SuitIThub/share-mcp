<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Share.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- blocking waits and cancellation tokens are fine in tests -->
    <NoWarn>$(NoWarn);xUnit1031;xUnit1051;xUnit2012;xUnit2013;xUnit2017</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <ProjectReference Include="../../src/Share.Core/Share.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
